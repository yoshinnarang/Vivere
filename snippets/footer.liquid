<footer>
  <div class="ftr-top">
    <div>
      <div class="ftr-brand">Vivere</div>
      <p class="ftr-tagline">Luxury nightwear for the woman who knows she deserves more. Because every night should feel like a retreat.</p>
      <div class="ftr-social">
        <a href="https://instagram.com/vivere.label" target="_blank" rel="noopener" aria-label="Instagram">IG</a>
        <a href="https://facebook.com/vivere.label" target="_blank" rel="noopener" aria-label="Facebook">FB</a>
      </div>
      <p class="ftr-nl-label">Stay in the loop</p>
      {% form 'customer' %}
        <div class="nl-form" style="max-width:320px;">
          <input class="nl-input" type="email" name="contact[email]" placeholder="Your email address" required>
          <button type="submit" class="nl-btn">Join</button>
        </div>
      {% endform %}
    </div>

    <div class="ftr-col">
      <p class="ftr-col-title">Shop</p>
      <a href="/collections/all">All Products</a>
      <a href="/collections/night-sets">Night Sets</a>
      <a href="/collections/night-dresses">Night Dresses</a>
      <a href="/collections/new-arrivals">New Arrivals</a>
      <a href="/collections/bestsellers">Bestsellers</a>
    </div>

    <div class="ftr-col">
      <p class="ftr-col-title">Help</p>
      <a href="/pages/size-guide">Size Guide</a>
      <a href="/pages/track-order">Track Order</a>
      <a href="/pages/returns">Returns</a>
      <a href="/pages/faq">FAQ</a>
      <a href="/pages/contact">Contact Us</a>
    </div>

    <div class="ftr-col">
      <p class="ftr-col-title">Vivere</p>
      <a href="/pages/our-story">Our Story</a>
    </div>
  </div>

  <div class="ftr-btm">
    <span>&copy; {{ 'now' | date: '%Y' }} Vivere. All rights reserved.</span>
    <div class="payment-icons">
      <span class="pay-icon">Razorpay</span>
      <span class="pay-icon">UPI</span>
      <span class="pay-icon">COD</span>
      <span class="pay-icon">Visa</span>
      <span class="pay-icon">Mastercard</span>
    </div>
    <span>
      <a href="/policies/privacy-policy" style="color:inherit;">Privacy</a> &middot;
      <a href="/policies/terms-of-service" style="color:inherit;">Terms</a>
    </span>
  </div>
</footer>
