<div class="blog-page reveal">
  <span class="sec-eye">Journal</span>
  <h1 class="sec-title" style="text-align:center;margin-bottom:40px;">{{ blog.title }}</h1>

  <div class="blog-grid">
    {%- for article in blog.articles -%}
      <div class="blog-card reveal {% cycle '', 'd1', 'd2' %}">
        {%- if article.image -%}
          <a href="{{ article.url }}" class="blog-card-img">
            <img src="{{ article.image | img_url: '600x400' }}" alt="{{ article.title | escape }}" loading="lazy">
          </a>
        {%- endif -%}
        <div class="blog-card-body">
          <span class="blog-date">{{ article.published_at | date: '%B %d, %Y' }}</span>
          <h2 class="blog-card-title"><a href="{{ article.url }}">{{ article.title }}</a></h2>
          <p class="blog-excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 25 }}</p>
          <a href="{{ article.url }}" class="blog-read-more">Read More &rarr;</a>
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- if blog.articles.size == 0 -%}
    <p style="text-align:center;color:var(--text-light);padding:60px 20px;">No articles yet. Check back soon.</p>
  {%- endif -%}
</div>
