<div class="gift-card-page" style="text-align:center;padding:80px 20px;">
  <span class="sec-eye">Gift Card</span>
  <h1 class="sec-title" style="margin-bottom:8px;">{{ shop.name }}</h1>
  <p style="color:var(--caramel);font-size:24px;font-family:var(--serif);margin-bottom:32px;">{{ gift_card.balance | money }}</p>

  <div class="gift-card-code" style="background:var(--ivory);border:2px dashed var(--caramel);border-radius:12px;padding:24px;max-width:400px;margin:0 auto 32px;font-family:monospace;font-size:20px;letter-spacing:3px;">
    {{ gift_card.code | format_code }}
  </div>

  {%- if gift_card.expired -%}
    <p style="color:#c44;margin-bottom:16px;">This gift card expired on {{ gift_card.expires_on | date: '%B %d, %Y' }}</p>
  {%- elsif gift_card.enabled -%}
    <p style="color:var(--text-light);margin-bottom:16px;">
      {%- if gift_card.expires_on -%}
        Expires {{ gift_card.expires_on | date: '%B %d, %Y' }}
      {%- else -%}
        No expiration date
      {%- endif -%}
    </p>
  {%- endif -%}

  <a href="{{ shop.url }}" class="btn btn-primary">Start Shopping</a>
</div>
