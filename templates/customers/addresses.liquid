<div class="account-page reveal" style="max-width:600px;margin:0 auto;padding:60px 20px;">
  <a href="/account" style="color:var(--caramel);font-size:14px;">&larr; Back to Account</a>
  <h1 class="sec-title" style="margin:16px 0 32px;">Your Addresses</h1>

  {%- for address in customer.addresses -%}
    <div class="address-card" style="border:1px solid var(--border);border-radius:12px;padding:24px;margin-bottom:16px;">
      {%- if address == customer.default_address -%}
        <span style="color:var(--caramel);font-size:12px;text-transform:uppercase;letter-spacing:1px;">Default</span>
      {%- endif -%}
      <p>{{ address | format_address }}</p>
      <div style="margin-top:12px;">
        <a href="/account/addresses/{{ address.id }}/edit" style="color:var(--caramel);font-size:14px;">Edit</a>
        &nbsp;&middot;&nbsp;
        <a href="/account/addresses/{{ address.id }}" data-method="delete" data-confirm="Are you sure?" style="color:#c44;font-size:14px;">Delete</a>
      </div>
    </div>
  {%- endfor -%}

  <details style="margin-top:32px;">
    <summary class="btn btn-outline" style="cursor:pointer;">Add New Address</summary>
    <div style="margin-top:20px;">
      {% form 'customer_address', customer.new_address %}
        <div class="form-group">
          <label for="address-first">First Name</label>
          <input type="text" id="address-first" name="address[first_name]" value="{{ form.first_name }}">
        </div>
        <div class="form-group">
          <label for="address-last">Last Name</label>
          <input type="text" id="address-last" name="address[last_name]" value="{{ form.last_name }}">
        </div>
        <div class="form-group">
          <label for="address-address1">Address</label>
          <input type="text" id="address-address1" name="address[address1]" value="{{ form.address1 }}">
        </div>
        <div class="form-group">
          <label for="address-city">City</label>
          <input type="text" id="address-city" name="address[city]" value="{{ form.city }}">
        </div>
        <div class="form-group">
          <label for="address-province">State</label>
          <input type="text" id="address-province" name="address[province]" value="{{ form.province }}">
        </div>
        <div class="form-group">
          <label for="address-zip">PIN Code</label>
          <input type="text" id="address-zip" name="address[zip]" value="{{ form.zip }}">
        </div>
        <div class="form-group">
          <label for="address-country">Country</label>
          <select id="address-country" name="address[country]">{{ country_option_tags }}</select>
        </div>
        <div class="form-group">
          <label for="address-phone">Phone</label>
          <input type="tel" id="address-phone" name="address[phone]" value="{{ form.phone }}">
        </div>
        <div class="form-group" style="margin-top:8px;">
          <label><input type="checkbox" name="address[default]" value="1"> Set as default</label>
        </div>
        <button type="submit" class="btn btn-primary">Save Address</button>
      {% endform %}
    </div>
  </details>
</div>
