<div class="account-page reveal" style="max-width:440px;margin:0 auto;padding:60px 20px;">
  <h1 class="sec-title" style="text-align:center;margin-bottom:32px;">Activate Account</h1>

  {% form 'activate_customer_password' %}
    <div class="form-group">
      <label for="password">Password</label>
      <input type="password" id="password" name="customer[password]" autocomplete="new-password" required>
    </div>
    <div class="form-group">
      <label for="password-confirm">Confirm Password</label>
      <input type="password" id="password-confirm" name="customer[password_confirmation]" autocomplete="new-password" required>
    </div>
    <button type="submit" class="btn btn-primary" style="width:100%;">Activate Account</button>
    <p style="text-align:center;margin-top:16px;font-size:14px;">
      <a href="/account/login" style="color:var(--caramel);">Decline invitation</a>
    </p>
  {% endform %}
</div>
