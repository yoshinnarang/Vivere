<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ page_title }} | Vivere</title>
  <meta name="description" content="{{ page_description | escape }}">
  <link rel="canonical" href="{{ canonical_url }}">
  <meta name="theme-color" content="#0D0A0E">
  <link rel="icon" type="image/png" sizes="32x32" href="{{ 'favicon-32.png' | asset_url }}">
  <link rel="apple-touch-icon" sizes="180x180" href="{{ 'favicon-180.png' | asset_url }}">

  <!-- Open Graph -->
  <meta property="og:title" content="{{ page_title }}">
  <meta property="og:description" content="{{ page_description | escape }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:site_name" content="Vivere">
  <meta property="og:type" content="{% if template contains 'product' %}product{% else %}website{% endif %}">
  {%- if page_image -%}<meta property="og:image" content="https:{{ page_image | img_url: '1200x630' }}">{%- endif -%}

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ page_title }}">
  <meta name="twitter:description" content="{{ page_description | escape }}">
  {%- if page_image -%}<meta name="twitter:image" content="https:{{ page_image | img_url: '1200x630' }}">{%- endif -%}

  <!-- Organization Schema -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Vivere",
    "url": "https://www.vivere.co.in",
    "logo": "{{ 'icon-main.png' | asset_url | prepend: 'https:' }}",
    "sameAs": [
      "https://instagram.com/vivere.label",
      "https://facebook.com/vivere.label"
    ],
    "contactPoint": {
      "@type": "ContactPoint",
      "email": "vivere.live@gmail.com",
      "contactType": "customer service"
    }
  }
  </script>

  {{ content_for_header }}

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,500;0,6..96,600;1,6..96,400;1,6..96,500&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">

  <!-- Swiper (for hero carousel) -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">

  {{ 'velour.css' | asset_url | stylesheet_tag }}
</head>
<body>

  {%- render 'header' -%}

  <!-- Mobile Nav Overlay -->
  <nav class="mobile-nav" aria-label="Mobile navigation">
    <a href="/collections/products">Collections</a>
    <a href="/collections/night-sets">Night Sets</a>
    <a href="/collections/new-arrivals">New In</a>
    <a href="/collections/sale">Sale</a>
    <a href="/pages/our-story">Our Story</a>
    <a href="/account">Account</a>
    <a href="/search">Search</a>
  </nav>

  <main id="main-content">
    {{ content_for_layout }}
  </main>

  {%- render 'footer' -%}

  {% comment %}
  <!-- WhatsApp Button -->
  <a href="https://wa.me/91{{ settings.whatsapp_number | default: '9999999999' }}?text=Hi%20Vivere!%20I%20have%20a%20question%20about%20your%20nightwear."
     class="whatsapp-btn"
     target="_blank"
     rel="noopener"
     aria-label="Chat on WhatsApp">
    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
    </svg>
  </a>
  {% endcomment %}

  <!-- Swiper JS -->
  <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
  {{ 'velour.js' | asset_url | script_tag }}
</body>
</html>
