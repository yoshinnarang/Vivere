<section class="hero">
  <div class="hero-bg"></div>
  <div class="hero-img-wrap">
    {%- if section.settings.hero_image != blank -%}
      <img class="hero-img"
        src="{{ section.settings.hero_image | img_url: '1800x' }}"
        alt="{{ section.settings.hero_image.alt | escape }}"
        loading="eager" fetchpriority="high">
    {%- else -%}
      <img class="hero-img"
        src="https://images.unsplash.com/photo-1631044551703-7e09d8e6acc6?w=1800&q=88&fit=crop&crop=top"
        alt="Velour Luxury Nightwear" loading="eager">
    {%- endif -%}
  </div>
  <div class="hero-grad"></div>
  <div class="hero-content">
    <div class="hero-season">
      <span>{{ section.settings.hero_eyebrow | default: 'SS 2025 — The Ivory Edit' }}</span>
    </div>
    <h1 class="hero-title">{{ section.settings.hero_title | default: 'Nights that feel like <em>luxury.</em>' }}</h1>
    <p class="hero-body">{{ section.settings.hero_subtitle | default: 'Premium coord sets and nightwear crafted for the modern Indian woman. Satin finishes, modal blends, lace details — all under ₹1,999.' }}</p>
    <div class="hero-btns">
      <a href="{{ section.settings.hero_cta_url | default: '/collections/all' }}" class="btn-primary">
        {{ section.settings.hero_cta_text | default: 'Shop the Collection' }}
      </a>
      <a href="{{ section.settings.hero_secondary_url | default: '/pages/our-story' }}" class="btn-outline">
        {{ section.settings.hero_secondary_text | default: 'Our Story →' }}
      </a>
    </div>
  </div>
  <div class="hero-scroll" aria-hidden="true">
    <span>Scroll</span>
    <div class="scroll-line"></div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    { "type": "image_picker", "id": "hero_image", "label": "Hero Image" },
    { "type": "text", "id": "hero_eyebrow", "label": "Eyebrow text", "default": "SS 2025 — The Ivory Edit" },
    { "type": "richtext", "id": "hero_title", "label": "Title", "default": "<p>Nights that feel like <em>luxury.</em></p>" },
    { "type": "textarea", "id": "hero_subtitle", "label": "Subtitle" },
    { "type": "text", "id": "hero_cta_text", "label": "Button text", "default": "Shop the Collection" },
    { "type": "url", "id": "hero_cta_url", "label": "Button URL" },
    { "type": "text", "id": "hero_secondary_text", "label": "Secondary link text", "default": "Our Story →" },
    { "type": "url", "id": "hero_secondary_url", "label": "Secondary link URL" }
  ],
  "presets": [{ "name": "Hero Banner" }]
}
{% endschema %}
