<section class="hero-carousel">
  <div class="swiper hero-swiper">
    <div class="swiper-wrapper">
      {%- for block in section.blocks -%}
        <div class="swiper-slide" {{ block.shopify_attributes }}>
          <div class="hero-bg"></div>
          <div class="hero-img-wrap">
            {%- if block.settings.image != blank -%}
              <img class="hero-img"
                src="{{ block.settings.image | img_url: '1800x' }}"
                alt="{{ block.settings.image.alt | escape }}"
                loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                {% if forloop.first %}fetchpriority="high"{% endif %}>
            {%- elsif block.settings.fallback_url != blank -%}
              <img class="hero-img"
                src="{{ block.settings.fallback_url }}"
                alt="Vivere Luxury Nightwear"
                loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
            {%- else -%}
              <img class="hero-img"
                src="{{ 'hero-slide-1.png' | asset_url }}"
                alt="Vivere Luxury Nightwear"
                loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
            {%- endif -%}
          </div>
          <div class="hero-grad"></div>

          <div class="hero-content">
            {%- if block.settings.eyebrow != blank -%}
              <div class="hero-season">
                <span>{{ block.settings.eyebrow }}</span>
              </div>
            {%- endif -%}

            <h2 class="hero-title">{{ block.settings.title | default: 'Nights that feel like <em>luxury.</em>' }}</h2>
            <p class="hero-body">{{ block.settings.subtitle }}</p>

            <div class="hero-btns">
              {%- if block.settings.cta_text != blank -%}
                <a href="{{ block.settings.cta_url | default: '/collections/products' }}" class="btn-primary">
                  {{ block.settings.cta_text }}
                </a>
              {%- endif -%}
              {%- if block.settings.secondary_text != blank -%}
                <a href="{{ block.settings.secondary_url | default: '/pages/our-story' }}" class="btn-outline">
                  {{ block.settings.secondary_text }}
                </a>
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>

    <!-- Pagination -->
    <div class="swiper-pagination"></div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Carousel",
  "settings": [],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Background Image" },
        { "type": "text", "id": "fallback_url", "label": "Fallback Image URL" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow text" },
        { "type": "richtext", "id": "title", "label": "Title", "default": "<p>Nights that feel like <em>luxury.</em></p>" },
        { "type": "textarea", "id": "subtitle", "label": "Subtitle" },
        { "type": "text", "id": "cta_text", "label": "Button text", "default": "Shop the Collection" },
        { "type": "url", "id": "cta_url", "label": "Button URL" },
        { "type": "text", "id": "secondary_text", "label": "Secondary link text" },
        { "type": "url", "id": "secondary_url", "label": "Secondary link URL" }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [{
    "name": "Hero Carousel",
    "blocks": [
      {
        "type": "slide",
        "settings": {
          "eyebrow": "The Collection",
          "title": "<p>Nights that feel like <em>luxury.</em></p>",
          "subtitle": "Premium nightwear crafted for the modern Indian woman.",
          "cta_text": "Shop the Collection",
          "secondary_text": "Our Story",
          "fallback_url": "/cdn/shop/assets/hero-slide-1.png"
        }
      },
      {
        "type": "slide",
        "settings": {
          "eyebrow": "New Arrivals",
          "title": "<p>The <em>Satin</em> Series</p>",
          "subtitle": "Buttery-soft satin that catches the light just so. 9 new styles, exclusively designed.",
          "cta_text": "Shop Satin",
          "fallback_url": "https://images.unsplash.com/photo-1617137968427-85924c800a22?w=1800&q=88&fit=crop&crop=top"
        }
      },
      {
        "type": "slide",
        "settings": {
          "eyebrow": "Affordable Luxury",
          "title": "<p>Feel extraordinary, <em>every night.</em></p>",
          "subtitle": "Premium quality, thoughtfully priced. Luxury that feels accessible.",
          "cta_text": "Explore All",
          "fallback_url": "https://images.unsplash.com/photo-1616137422495-1e9e46e2aa1e?w=1800&q=88&fit=crop&crop=top"
        }
      }
    ]
  }]
}
{% endschema %}
