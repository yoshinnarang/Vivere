<div id="collections">
  <div class="sec-hdr reveal">
    <span class="sec-eye">{{ section.settings.eyebrow | default: 'Curated Collections' }}</span>
    <h2 class="sec-title">{{ section.settings.title | default: 'Find your <em>mood</em>' }}</h2>
    <p class="sec-sub">{{ section.settings.subtitle | default: 'Five distinct edits — each a mood, a moment, a feeling. Discover yours.' }}</p>
    <div class="sec-line"></div>
  </div>

  <div class="colls-wrap">
    <div class="colls-grid">
      {%- for block in section.blocks -%}
        <div class="coll-card {% if forloop.first %}tall{% else %}short{% endif %} reveal {% if forloop.index == 2 %}d1{% elsif forloop.index == 3 %}d2{% elsif forloop.index == 4 %}d1{% elsif forloop.index == 5 %}d2{% endif %}"
          {% unless forloop.first %}{% if forloop.index == 4 %}style="grid-column:2;"{% elsif forloop.index == 5 %}style="grid-column:3;"{% endif %}{% endunless %}
          {{ block.shopify_attributes }}>

          {%- if block.settings.image != blank -%}
            <img class="coll-img"
              src="{{ block.settings.image | img_url: '800x' }}"
              alt="{{ block.settings.title }}"
              loading="lazy">
          {%- else -%}
            <img class="coll-img"
              src="{{ block.settings.fallback_image_url }}"
              alt="{{ block.settings.title }}"
              loading="lazy">
          {%- endif -%}

          <div class="coll-veil">
            <p class="coll-tag">{{ block.settings.tag }}</p>
            <h3 class="coll-name">{{ block.settings.title }}</h3>
            <p class="coll-count">{{ block.settings.count }}</p>
            <a href="{{ block.settings.link }}" class="coll-cta">{{ block.settings.cta | default: 'Explore' }} &rarr;</a>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Collections Grid",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Curated Collections" },
    { "type": "text", "id": "title", "label": "Title", "default": "Find your mood" },
    { "type": "text", "id": "subtitle", "label": "Subtitle" }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "fallback_image_url", "label": "Fallback image URL" },
        { "type": "text", "id": "tag", "label": "Tag (e.g. New Season)" },
        { "type": "text", "id": "title", "label": "Collection name" },
        { "type": "text", "id": "count", "label": "Item count text" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "text", "id": "cta", "label": "CTA text", "default": "Explore" }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [{ "name": "Collections Grid" }]
}
{% endschema %}
