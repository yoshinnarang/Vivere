{% schema %}
{
  "name": "Reviews Section",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Worn. Loved. Repeated." },
    { "type": "text", "id": "stars", "label": "Star rating", "default": "4.9" },
    { "type": "text", "id": "review_count", "label": "Review count", "default": "2,400+" }
  ],
  "presets": [{ "name": "Reviews Section" }]
}
{% endschema %}
