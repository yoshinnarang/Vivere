<div id="bestsellers">
  <div class="bs-wrap">
    <div class="bs-hdr reveal">
      <div class="bs-hdr-left">
        <h2 class="bs-heading">{{ section.settings.title | default: 'Best Sellers' }}</h2>
      </div>
      <div class="bs-hdr-right">
        <!-- Category tabs -->
        <div class="bs-tabs" role="tablist">
          {%- for block in section.blocks -%}
            {%- if block.type == 'tab' -%}
              <button class="bs-tab {% if forloop.first %}active{% endif %}"
                role="tab"
                data-tab="{{ block.settings.handle }}"
                {{ block.shopify_attributes }}>
                {{ block.settings.label }}
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>
        <div class="bs-arrows">
          <button class="bs-arrow bs-arrow-prev" aria-label="Previous">&larr;</button>
          <button class="bs-arrow bs-arrow-next" aria-label="Next">&rarr;</button>
        </div>
      </div>
    </div>

    <div class="bs-scroll-wrap">
      {%- for block in section.blocks -%}
        {%- if block.type == 'tab' -%}
          {%- assign collection = collections[block.settings.handle] -%}
          <div class="bs-scroll reveal" data-tab="{{ block.settings.handle }}" style="display: {% if forloop.first %}flex{% else %}none{% endif %};">
            {%- if collection.products.size > 0 -%}
              {%- for product in collection.products limit: 6 -%}
                <div class="prod bs-card">
                  <div class="prod-img-box">
                    <a href="{{ product.url }}">
                      {%- if product.featured_image -%}
                        <img class="prod-img-primary"
                          src="{{ product.featured_image | img_url: '500x667' }}"
                          alt="{{ product.title | escape }}"
                          loading="lazy">
                      {%- else -%}
                        <img class="prod-img-primary"
                          src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=500&h=667&q=80&fit=crop"
                          alt="{{ product.title | escape }}"
                          loading="lazy">
                      {%- endif -%}
                      {%- if product.images.size > 1 -%}
                        <img class="prod-img-secondary"
                          src="{{ product.images[1] | img_url: '500x667' }}"
                          alt="{{ product.title | escape }} - alternate"
                          loading="lazy">
                      {%- endif -%}
                    </a>
                    {%- if product.tags contains 'new-in' -%}
                      <span class="prod-badge new">New In</span>
                    {%- elsif product.tags contains 'bestseller' -%}
                      <span class="prod-badge bestseller">Bestseller</span>
                    {%- elsif product.tags contains 'trending' -%}
                      <span class="prod-badge trending">Trending</span>
                    {%- endif -%}
                    <div class="prod-actions">
                      <form action="/cart/add" method="post" style="width: 100%;">
                        <input type="hidden" name="id" value="{{ product.variants.first.id }}">
                        <button type="submit" class="prod-btn">Add to Bag</button>
                      </form>
                    </div>
                  </div>

                  <h3 class="prod-name"><a href="{{ product.url }}">{{ product.title }}</a></h3>

                  <div class="prod-price-row">
                    <span class="prod-price">{{ product.price | money }}</span>
                    {%- if product.compare_at_price > product.price -%}
                      <span class="prod-mrp">{{ product.compare_at_price | money }}</span>
                    {%- endif -%}
                  </div>
                </div>
              {%- endfor -%}

              <!-- VIEW ALL CARD -->
              <div class="prod bs-card bs-viewall">
                <div class="prod-img-box" style="background: var(--ivory); display: flex; align-items: center; justify-content: center;">
                  <div style="text-align: center;">
                    <h3 class="prod-name" style="font-size: 18px; margin-bottom: 8px;">{{ block.settings.label }}</h3>
                    <a href="/collections/{{ block.settings.handle }}" style="text-decoration: underline; color: var(--midnight); font-size: 14px;">View all</a>
                  </div>
                </div>
              </div>
            {%- else -%}
              <div style="padding: 40px; text-align: center; color: var(--midnight);">
                <p>No products in this collection yet.</p>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<script>
(function(){
  var bestsellerSection = document.getElementById('bestsellers');
  if (!bestsellerSection) return;

  var prevBtn = bestsellerSection.querySelector('.bs-arrow-prev');
  var nextBtn = bestsellerSection.querySelector('.bs-arrow-next');
  var scrollAmt = 340;

  // Scroll arrow functionality
  if (prevBtn) {
    prevBtn.addEventListener('click', function() {
      var activeScroll = bestsellerSection.querySelector('.bs-scroll[style*="display: flex"]');
      if (activeScroll) {
        activeScroll.scrollBy({ left: -scrollAmt, behavior: 'smooth' });
      }
    });
  }

  if (nextBtn) {
    nextBtn.addEventListener('click', function() {
      var activeScroll = bestsellerSection.querySelector('.bs-scroll[style*="display: flex"]');
      if (activeScroll) {
        activeScroll.scrollBy({ left: scrollAmt, behavior: 'smooth' });
      }
    });
  }

  // Tab switching
  var tabs = bestsellerSection.querySelectorAll('.bs-tab');
  tabs.forEach(function(tab) {
    tab.addEventListener('click', function() {
      var tabHandle = this.getAttribute('data-tab');

      // Update active tab
      tabs.forEach(function(t) { t.classList.remove('active'); });
      this.classList.add('active');

      // Show/hide product lists
      var scrolls = bestsellerSection.querySelectorAll('.bs-scroll');
      scrolls.forEach(function(scroll) {
        if (scroll.getAttribute('data-tab') === tabHandle) {
          scroll.style.display = 'flex';
        } else {
          scroll.style.display = 'none';
        }
      });
    });
  });

  // Add to Cart functionality
  var addToCartButtons = bestsellerSection.querySelectorAll('.add-to-cart');
  addToCartButtons.forEach(function(button) {
    button.addEventListener('click', function(e) {
      e.preventDefault();
      var productHandle = this.getAttribute('data-product-handle');

      fetch('/products/' + productHandle + '.json')
        .then(response => response.json())
        .then(data => {
          var variantId = data.product.variants[0].id;

          // Add to cart using Shopify's cart API
          fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({
              items: [{
                id: variantId,
                quantity: 1
              }]
            })
          })
          .then(response => response.json())
          .then(data => {
            // Show success message or redirect to cart
            window.location.href = '/cart';
          })
          .catch(error => console.error('Error adding to cart:', error));
        })
        .catch(error => console.error('Error fetching product:', error));
    });
  });
})();
</script>

{% schema %}
{
  "name": "Bestsellers",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Best Sellers" },
    { "type": "collection", "id": "collection", "label": "Collection to feature" },
    { "type": "url", "id": "link", "label": "View all link" }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Category Tab",
      "settings": [
        { "type": "text", "id": "label", "label": "Tab label", "default": "Night Sets" },
        { "type": "text", "id": "handle", "label": "Collection handle", "default": "night-sets" }
      ]
    }
  ],
  "presets": [{ "name": "Bestsellers" }]
}
{% endschema %}
