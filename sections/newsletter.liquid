<section class="newsletter-section reveal">
  <div class="nl-inner">
    <span class="nl-eye">Stay in the Loop</span>
    <h2 class="nl-title">Be the first to know about <em>new drops</em></h2>
    <p class="nl-desc">Exclusive early access, styling tips, and members-only offers — straight to your inbox. No spam, just beautiful things.</p>

    {% form 'customer' %}
      <div class="nl-form">
        <input class="nl-input" type="email" name="contact[email]" placeholder="Your email address" required autocomplete="email">
        <button type="submit" class="nl-btn">Join</button>
      </div>
    {% endform %}

    <p class="nl-privacy">We respect your privacy. Unsubscribe anytime.</p>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
